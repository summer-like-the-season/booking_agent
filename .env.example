# Copy this file to .env and fill in the values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here

BOOKING_URL=paste-booking-page-link-here

# The booking is made under this account (also the Google Cloud / OAuth account).
BOOKER_FIRST_NAME=YourFirstName
BOOKER_LAST_NAME=YourLastName
BOOKER_EMAIL=your-name@gmail.com

# Added as guests on every booked event (comma-separated).
INVITE_EMAILS=your-name@ucsb.edu

# Gets an email from your Gmail each time a meeting is booked. Leave empty to turn off.
NOTIFY_EMAIL=your-name@ucsb.edu

# Calendars checked for conflicts (comma-separated). "primary" is your Gmail calendar.
# your-name@ucsb.edu only works once you share its free/busy with your Gmail account (see README).
BUSY_CALENDARS=primary,your-name@ucsb.edu

TIMEZONE=America/Los_Angeles

# ---- Automatic mode (python agent.py --auto) ----
# One booking per window of AUTO_INTERVAL_DAYS, starting AUTO_START_DATE.
AUTO_START_DATE=2026-10-05
AUTO_END_DATE=2026-12-11
AUTO_INTERVAL_DAYS=14
# The whole meeting must fit inside this time range (24-hour clock).
AUTO_TIME_WINDOW=11:00-13:00
# true = no browser window pops up during scheduled runs.
HEADLESS=false
